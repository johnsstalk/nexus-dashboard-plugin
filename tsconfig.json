{
	"compilerOptions": {
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2020",
		"allowJs": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"moduleResolution": "bundler",
		"isolatedModules": true,
		"skipLibCheck": true,
		"lib": ["DOM", "ES2021"]
	},
	"include": ["src/**/*.ts"]
}
